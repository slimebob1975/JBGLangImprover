# For local iframe embedding, put it right here
FRAME_ANCESTORS=https://www.iaf.se
APP_TITLE="Klarspråkshjälpen"

# Highest number of simultaneous model calls in the local review (default 4).
# The global review runs alongside them. Set to 1 for calls in sequence.
# JBG_MAX_PARALLEL_MODEL_CALLS=4

# Keep the upload and its JSON files after a run, and show document text in the logs.
# For troubleshooting in development environments only (default off).
# JBG_KEEP_DEBUG_DATA=1
